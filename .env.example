# Copy to .env.local for local development (.env and .env.local are not committed).

# Backend host only, without /api/v1. API routes live under /api/v1 on this host.
VITE_API_URL=https://health-heat.onrender.com

# Where data comes from: "api" (the backend) or "mock" (sample data in src/data/mock.ts).
# If left empty, the app uses "api" when VITE_API_URL is set and "mock" when it is empty.
VITE_DATA_SOURCE=mock
